# Copy this file to .env and fill in the values.

# PostgreSQL connection string (free DB: https://neon.tech). Must include ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# API port (Render/host sets this automatically in production)
PORT=4000

# Auth — use a long random string for JWT_SECRET in production
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN="30d"

# Default admin account (created/updated on seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Chủ cửa hàng"

# Insert the demo catalogue/customers/invoices on seed? ("true" = yes, anything else = admin only)
SEED_SAMPLE="true"

# Allowed CORS origins, comma-separated, or "*" (same-origin in production so "*" is safe)
CORS_ORIGIN="*"
